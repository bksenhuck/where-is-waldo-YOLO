# ── Server ────────────────────────────────────────────────────────────────────
PORT=8050
DEBUG=false
API_BASE=http://localhost:8050
# Cloud Run: API_BASE=https://<your-cloud-run-service-url>

# ── GCS (Google Cloud Storage) ────────────────────────────────────────────────
GCS_BUCKET_NAME=where-is-waldo-artifacts
# Sub-paths inside the bucket
GCS_MODELS_PREFIX=models
GCS_ASSETS_PREFIX=assets
GCS_DATA_PREFIX=data

# ── Google credentials (local dev) ────────────────────────────────────────────
# Point to your service-account JSON key when running locally.
# On Cloud Run this env var is NOT needed — use Workload Identity instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
