# ── Server ────────────────────────────────────────────────────────────────────
PORT=8050
DEBUG=false
API_BASE=http://localhost:8050
# Cloud Run: API_BASE=https://<your-cloud-run-service-url>

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret used by Dash callbacks to authenticate against FastAPI.
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Store in GCP Secret Manager + GitHub Secrets — never commit the real value.
INTERNAL_API_KEY=

# Comma-separated list of allowed CORS origins (leave empty to disable CORS).
# Example: https://my-app.run.app,https://my-app.web.app
CORS_ALLOW_ORIGINS=

# Set to "true" only in local development to enable /api/docs and /api/redoc.
ENABLE_API_DOCS=false

# Rate limits (requests per minute per IP). Defaults shown.
RATE_LIMIT_SCENE=30/minute
RATE_LIMIT_DETECT=30/minute

# ── GCS (Google Cloud Storage) ────────────────────────────────────────────────
GCS_BUCKET_NAME=where-is-waldo-artifacts
GCS_MODELS_PREFIX=models
GCS_ASSETS_PREFIX=assets
GCS_DATA_PREFIX=data

# ── Google credentials (local dev only) ───────────────────────────────────────
# On Cloud Run use Workload Identity — do NOT set this var in production.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
